{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "branchPrefix": "renovate/",
  "packageRules": [
    {
      "enabled": true,
      "automerge": false,
      "baseBranchPatterns": [
        "rhoai-2.13"
      ],
      "matchManagers": [
        "tekton",
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "matchUpdateTypes": [
        "major",
        "bump",
        "patch"
      ],
      "matchManagers": [
        "tekton",
        "dockerfile"
      ],
      "enabled": false
    }
  ],
  "prHourlyLimit": 0
}
